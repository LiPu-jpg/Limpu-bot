# NoneBot 运行时
HOST=127.0.0.1
PORT=8090
COMMAND_START=["/"]

# 后端服务（本机环回）
LIMPU_COURSESERVER_BASE_URL=http://127.0.0.1:8081
LIMPU_AGENT_BASE_URL=http://127.0.0.1:8080
LIMPU_CAMPUS=shenzhen

# LLM（DeepSeek，OpenAI 兼容接口），用于 /ai 对话与 PR 合规审核
LIMPU_LLM_API_KEY=
LIMPU_LLM_BASE_URL=https://api.deepseek.com
LIMPU_LLM_MODEL=deepseek-chat

# PR 提交白名单（逗号分隔 QQ 号；留空=所有人可提交）
LIMPU_PR_ALLOWED_USERS=

# 会话超时（秒）
LIMPU_SESSION_TTL=1800

# RAG 全文补全：命中片段时读取该仓库的原文（doc_id 即仓库路径）
# bot 会将仓库浅克隆到 LIMPU_RAG_REPO_DIR 并每 LIMPU_RAG_SYNC_INTERVAL 秒 git pull
LIMPU_RAG_FULLTEXT_REPO=HIT-A/HITA_RagData
LIMPU_RAG_REPO_DIR=data/HITA_RagData
LIMPU_RAG_SYNC_INTERVAL=1800
# 可选：GitHub token（本地未同步时走 API 兜底，避免匿名限流）
LIMPU_GITHUB_TOKEN=
